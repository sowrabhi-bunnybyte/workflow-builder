# ---------------------------------------------------------------------------
# Copy this file to ".env" in the same folder and fill in what you need.
# The app works with ZERO keys set (deterministic rule-based mode) — only
# add a key if you want smarter, more natural conversations.
# ---------------------------------------------------------------------------

# Which free-tier LLM to use: "groq" (default, recommended) or "gemini".
# Leave both keys blank to run fully offline on the rule-based engine.
LLM_PROVIDER=groq

# --- Groq (https://console.groq.com/keys) — free, no credit card ----------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- Google Gemini (https://aistudio.google.com/app/apikey) — free tier ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Milliseconds before an LLM call is abandoned in favor of the fallback.
LLM_TIMEOUT_MS=15000

# Server port
PORT=8787

# Comma-free single origin allowed to call the API in dev (Vite default).
CLIENT_ORIGIN=http://localhost:5173

# How long an idle conversation stays in memory (ms).
SESSION_TTL_MS=7200000
